<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Sales Director Security Group -->
        <record id="group_sale_director" model="res.groups">
            <field name="name">Sales Director</field>
            <field name="sequence">40</field>
            <field name="privilege_id" ref="sales_team.res_groups_privilege_sales"/>
            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
            <field name="comment">Allows approving quotations with discounts exceeding 10% and full management over commissions.</field>
        </record>

        <!-- Ensure Sales users have line discount permissions enabled -->
        <record id="sales_team.group_sale_salesman" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('sale.group_discount_per_so_line'))]"/>
        </record>

        <!-- Multi-Company Rules for Monthly Commission -->
        <record id="sale_monthly_commission_comp_rule" model="ir.rule">
            <field name="name">Monthly Commission: Multi-Company</field>
            <field name="model_id" ref="model_sale_monthly_commission"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Record Rule: Salesperson Own Commission Sheets -->
        <record id="sale_monthly_commission_salesman_rule" model="ir.rule">
            <field name="name">Salesperson: Own Monthly Commissions</field>
            <field name="model_id" ref="model_sale_monthly_commission"/>
            <field name="domain_force">[('salesperson_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Record Rule: Sales Manager All Commission Sheets -->
        <record id="sale_monthly_commission_manager_rule" model="ir.rule">
            <field name="name">Sales Manager: All Monthly Commissions</field>
            <field name="model_id" ref="model_sale_monthly_commission"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Multi-Company Rule for Commission Lines -->
        <record id="sale_monthly_commission_line_comp_rule" model="ir.rule">
            <field name="name">Monthly Commission Line: Multi-Company</field>
            <field name="model_id" ref="model_sale_monthly_commission_line"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('commission_id.company_id', '=', False), ('commission_id.company_id', 'in', company_ids)]</field>
        </record>

        <!-- Record Rule: Salesperson Own Commission Lines -->
        <record id="sale_monthly_commission_line_salesman_rule" model="ir.rule">
            <field name="name">Salesperson: Own Commission Lines</field>
            <field name="model_id" ref="model_sale_monthly_commission_line"/>
            <field name="domain_force">[('commission_id.salesperson_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Record Rule: Sales Manager All Commission Lines -->
        <record id="sale_monthly_commission_line_manager_rule" model="ir.rule">
            <field name="name">Sales Manager: All Commission Lines</field>
            <field name="model_id" ref="model_sale_monthly_commission_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
