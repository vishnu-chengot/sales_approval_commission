<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Monthly Commission Sheets -->
        <record id="seq_sale_monthly_commission" model="ir.sequence">
            <field name="name">Monthly Sales Commission</field>
            <field name="code">sale.monthly.commission</field>
            <field name="prefix">COMM/%(range_year)s/%(range_month)s/</field>
            <field name="padding">4</field>
            <field name="use_date_range" eval="True"/>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
